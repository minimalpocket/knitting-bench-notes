<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Check Area Parser</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: #1a1a1a;
      color: #ddd;
      font-family: system-ui, sans-serif;
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    #header {
      height: 42px;
      background: #222;
      display: flex;
      align-items: center;
      padding: 0 12px;
      gap: 10px;
      border-bottom: 1px solid #333;
      flex-shrink: 0;
      font-size: 13px;
    }
    #header .title { color: #999; font-weight: 600; letter-spacing: 0.02em; }
    .header-sep { width: 1px; height: 20px; background: #333; flex-shrink: 0; }
    #header-status { color: #777; font-size: 12px; }
    .header-spacer { flex: 1; }
    .hdr-btn {
      background: none; border: 1px solid #444; color: #999;
      font-size: 12px; padding: 3px 10px; border-radius: 4px; cursor: pointer; white-space: nowrap;
    }
    .hdr-btn:hover { border-color: #666; color: #ccc; }
    #clear-btn:hover { border-color: #f66; color: #f66; }
    .fmt-btn {
      background: #2a2a2a; border: 1px solid #444; color: #aaa;
      font-size: 12px; padding: 3px 10px; border-radius: 4px; cursor: pointer;
      font-family: 'SF Mono', 'Consolas', monospace;
    }
    .fmt-btn:hover { border-color: #666; color: #ccc; }
    .fmt-btn.active { border-color: #0af; color: #0af; background: #0af1; }
    #copy-btn {
      background: #0af2; border: 1px solid #0af5; color: #0af;
      font-size: 12px; padding: 3px 12px; border-radius: 4px; cursor: pointer;
    }
    #copy-btn:hover { background: #0af3; }
    #copy-btn.copied { color: #0f0; border-color: #0f05; }
    .header-actions { display: none; align-items: center; gap: 8px; }
    .header-actions.visible { display: flex; }

    #drop-zone {
      flex: 1; display: flex; align-items: center; justify-content: center;
      border: 3px dashed #444; margin: 20px; border-radius: 12px;
      cursor: pointer; color: #555; font-size: 20px;
      transition: border-color 0.15s, color 0.15s;
      flex-direction: column; gap: 8px;
    }
    #drop-zone.dragover { border-color: #0af; color: #0af; }
    #drop-zone .sub { font-size: 13px; }
    #drop-zone.hidden { display: none; }

    #main { flex: 1; display: none; overflow: hidden; }
    #main.visible { display: flex; }

    #results-panel { flex: 1; overflow-y: auto; padding: 12px 16px; min-width: 0; }
    .file-group { margin-bottom: 20px; }
    .file-header {
      font-size: 13px; color: #888; padding: 4px 0 6px; border-bottom: 1px solid #333;
      margin-bottom: 6px; display: flex; align-items: center; gap: 8px; position: relative;
    }
    .file-header .thumb {
      width: 24px; height: 24px; object-fit: contain; border-radius: 3px;
      border: 1px solid #444; cursor: pointer; flex-shrink: 0; background: #333;
    }
    .file-header .thumb:hover { border-color: #888; }
    .file-header .fname { color: #aaa; font-weight: 600; }
    .file-header .opline-tag {
      font-family: 'SF Mono', 'Consolas', monospace; font-size: 12px; color: #0af;
      background: #0af1a; padding: 1px 6px; border-radius: 3px; border: 1px solid #0af44;
    }
    .file-header .entry-count { color: #888; margin-left: auto; font-size: 12px; }
    .file-error { color: #f66; font-size: 13px; padding: 8px 0; }

    .thumb-popup {
      /*display: none;*/
      opacity: 0;
      position: absolute; z-index: 200; left: 0; top: 30px;
      background: #222; border: 1px solid #555; border-radius: 6px; padding: 4px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.6); pointer-events: none;
      transition: opacity 0.1s;
    }
    .thumb:hover + .thumb-popup { display: block; opacity: 1; }
    .thumb-popup img { display: block; max-width: 320px; max-height: 400px; border-radius: 3px; }

    table.results { border-collapse: collapse; font-size: 13px; width: 100%; max-width: 420px; }
    table.results th {
      text-align: left; color: #666; font-weight: 500; padding: 3px 8px;
      border-bottom: 1px solid #333; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;
    }
    table.results td { padding: 2px 8px; font-family: 'SF Mono', 'Consolas', monospace; font-size: 13px; }
    table.results tr:hover { background: #ffffff08; }
    .swatch { display: inline-block; width: 12px; height: 12px; border-radius: 2px; border: 1px solid #555; vertical-align: middle; }
    .col-iro { color: #ccc; text-align: right; width: 3em; }
    .col-count { color: #ccc; text-align: right; }
    .col-pct { color: #777; text-align: right; width: 5em; }

    #output-panel {
      width: 420px; flex-shrink: 0; border-left: 1px solid #333;
      display: flex; flex-direction: column; background: #1e1e1e;
    }
    #output-preview {
      flex: 1; overflow: auto; padding: 10px 14px;
      font-family: 'SF Mono', 'Consolas', monospace; font-size: 12px;
      line-height: 1.5; white-space: pre; color: #aaa; tab-size: 2;
    }
    #file-input { display: none; }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #444; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #555; }
  </style>
