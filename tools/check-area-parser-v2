let allResults = [];
let currentFormat = 'md';

function rgbCss(packed) {
  return `rgb(${(packed>>16)&0xff},${(packed>>8)&0xff},${packed&0xff})`;
}

function loadAndParse(file) {
  return new Promise((resolve) => {
    const thumbUrl = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      const canvas = document.createElement('canvas');
      canvas.width = img.naturalWidth;
      canvas.height = img.naturalHeight;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0);
      const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
      const result = parseCheckArea(imageData, file.name);
      result.thumbUrl = thumbUrl;
      resolve(result);
    };
    img.onerror = () => {
      URL.revokeObjectURL(thumbUrl);
      resolve({ filename: file.name, opline: null, error: 'Failed to load image', entries: [], thumbUrl: null });
    };
    img.src = thumbUrl;
  });
}

function renderResults() {
  resultsPanel.innerHTML = '';
  for (const result of allResults) {
    const group = document.createElement('div');
    group.className = 'file-group';
    const header = document.createElement('div');
    header.className = 'file-header';

    if (result.thumbUrl) {
      const thumb = document.createElement('img');
      thumb.className = 'thumb';
      thumb.src = result.thumbUrl;
      header.appendChild(thumb);
      const popup = document.createElement('div');
      popup.className = 'thumb-popup';
      popup.innerHTML = `<img src="${result.thumbUrl}">`;
      header.appendChild(popup);
    }

    const fname = document.createElement('span');
    fname.className = 'fname';
    fname.textContent = result.filename;
    header.appendChild(fname);
    if (result.opline) {
      const tag = document.createElement('span');
      tag.className = 'opline-tag';
      tag.textContent = result.opline;
      header.appendChild(tag);
    }
    if (result.entries.length > 0) {
      const count = document.createElement('span');
      count.className = 'entry-count';
      count.textContent = `${result.entries.length} entries`;
      header.appendChild(count);
    }
    group.appendChild(header);

    if (result.error) {
      const err = document.createElement('div');
      err.className = 'file-error';
      err.textContent = result.error;
      group.appendChild(err);
    }
    if (result.entries.length > 0) {
      const total = result.entries.reduce((s, e) => s + e.count, 0);
      const table = document.createElement('table');
      table.className = 'results';
      table.innerHTML = '<thead><tr><th></th><th>iro</th><th>count</th><th>%</th></tr></thead>';
      const tbody = document.createElement('tbody');
      for (const { iro, count } of result.entries) {
        const pct = total > 0 ? (count / total * 100).toFixed(2) : '—';
        const tr = document.createElement('tr');
        tr.innerHTML =
          `<td><span class="swatch" style="background:${rgbCss(STD_PALETTE[iro] ?? 0)}"></span></td>` +
          `<td class="col-iro">${iro}</td>` +
          `<td class="col-count">${count.toLocaleString()}</td>` +
          `<td class="col-pct">${pct}%</td>`;
        tbody.appendChild(tr);
      }
      table.appendChild(tbody);
      group.appendChild(table);
    }
    resultsPanel.appendChild(group);
  }
  renderOutput();
  updateStatus();
}

// ---- Output formatting ----
const pad = (s, w) => s + ' '.repeat(Math.max(0, w - s.length));
const lpad = (s, w) => ' '.repeat(Math.max(0, w - s.length)) + s;

function formatEdn(results) {
  const parts = [];
  for (const r of results) {
    if (r.entries.length === 0) continue;
    const label = r.opline ? `"${r.opline}"` : `"${r.filename}"`;
    const pairs = r.entries.map(e => `${e.iro} ${e.count}`).join(', ');
    parts.push(`[${label} {${pairs}}]`);
  }
  if (parts.length === 1) {
    const r = results.find(r => r.entries.length > 0);
    if (!r) return ';; no data';
    return `{${r.entries.map(e => `${e.iro} ${e.count}`).join(', ')}}`;
  }
  return parts.join('\n');
}

function formatJson(results) {
  const obj = {};
  for (const r of results) {
    if (r.entries.length === 0) continue;
    const key = r.opline ?? r.filename;
    const map = {};
    for (const e of r.entries) map[e.iro] = e.count;
    obj[key] = map;
  }
  const keys = Object.keys(obj);
  return JSON.stringify(keys.length === 1 ? obj[keys[0]] : obj, null, 2);
}

function formatMarkdown(results) {
  const sections = [];
  for (const r of results) {
    if (r.entries.length === 0) continue;
    const heading = r.opline ? `### ${r.opline}` : `### ${r.filename}`;
    const total = r.entries.reduce((s, e) => s + e.count, 0);
    const col1H = r.opline ? `${r.opline}=` : 'iro';
    const rows = r.entries.map(e => ({
      iro: String(e.iro),
      count: String(e.count),
      pct: total > 0 ? (e.count / total * 100).toFixed(2) + '%' : '—',
    }));
    const w1 = Math.max(col1H.length, ...rows.map(r => r.iro.length));
    const w2 = Math.max(5, ...rows.map(r => r.count.length));
    const w3 = Math.max(1, ...rows.map(r => r.pct.length));
    const w4 = 5;
    const hdr = `| ${pad(col1H, w1)} | ${pad('count', w2)} | ${pad('%', w3)} | ${pad('Notes', w4)} |`;
    const sep = `|${'-'.repeat(w1+2)}|${'-'.repeat(w2+2)}|${'-'.repeat(w3+2)}|${'-'.repeat(w4+2)}|`;
    const dataRows = rows.map(r =>
      `| ${lpad(r.iro, w1)} | ${lpad(r.count, w2)} | ${lpad(r.pct, w3)} | ${' '.repeat(w4)} |`
    );
    sections.push([heading, '', hdr, sep, ...dataRows].join('\n'));
  }
  return sections.join('\n\n');
}

function renderOutput() {
  const fmt = { edn: formatEdn, json: formatJson, md: formatMarkdown };
  outputPreview.textContent = (fmt[currentFormat] ?? formatEdn)(allResults);
}

function updateStatus() {
  const n = allResults.length;
  const entries = allResults.reduce((s, r) => s + r.entries.length, 0);
  const errs = allResults.filter(r => r.error).length;
  let parts = [`${n} file${n !== 1 ? 's' : ''}`, `${entries} entries`];
  if (errs > 0) parts.push(`${errs} failed`);
  headerStatus.textContent = parts.join(' · ');
}

// ---- File handling ----
async function processFiles(files) {
  const imgs = Array.from(files).filter(f =>
    f.type.startsWith('image/') || /\.(png|jpe?g|gif|bmp|webp)$/i.test(f.name)
  );
  if (imgs.length === 0) return;
  dropZone.classList.add('hidden');
  main.classList.add('visible');
  headerActions.classList.add('visible');
  fmtActions.classList.add('visible');
  headerStatus.textContent = `Processing ${imgs.length} file${imgs.length > 1 ? 's' : ''}...`;
  for (const file of imgs) allResults.push(await loadAndParse(file));
  allResults.sort((a, b) => {
    if (!a.opline && !b.opline) return a.filename.localeCompare(b.filename);
    if (!a.opline) return 1;
    if (!b.opline) return -1;
    const sa = a.opline[0], sb = b.opline[0];
    if (sa !== sb) return sa === 'L' ? -1 : 1;
    return parseInt(a.opline.slice(1)) - parseInt(b.opline.slice(1));
  });
  renderResults();
}

function clearAll() {
  for (const r of allResults) if (r.thumbUrl) URL.revokeObjectURL(r.thumbUrl);
  allResults = [];
  resultsPanel.innerHTML = '';
  outputPreview.textContent = '';
  dropZone.classList.remove('hidden');
  main.classList.remove('visible');
  headerActions.classList.remove('visible');
  fmtActions.classList.remove('visible');
  headerStatus.textContent = '';
}

// ---- Events ----
['dragenter','dragover','dragleave','drop'].forEach(e =>
  document.addEventListener(e, ev => { ev.preventDefault(); ev.stopPropagation(); }));
document.addEventListener('dragenter', () => dropZone.classList.add('dragover'));
document.addEventListener('dragleave', e => {
  if (!e.relatedTarget || e.relatedTarget === document.documentElement)
    dropZone.classList.remove('dragover');
});
document.addEventListener('drop', e => {
  dropZone.classList.remove('dragover');
  if (e.dataTransfer.files.length) processFiles(e.dataTransfer.files);
});
dropZone.addEventListener('click', () => fileInput.click());
addMoreBtn.addEventListener('click', () => fileInput.click());
fileInput.addEventListener('change', e => {
  if (e.target.files.length) processFiles(e.target.files);
  e.target.value = '';
});
clearBtn.addEventListener('click', clearAll);
document.querySelectorAll('.fmt-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.fmt-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentFormat = btn.dataset.fmt;
    renderOutput();
  });
});
copyBtn.addEventListener('click', () => {
  const text = outputPreview.textContent;
  if (!text) return;
  navigator.clipboard.writeText(text).then(() => {
    copyBtn.textContent = 'Copied';
    copyBtn.classList.add('copied');
    setTimeout(() => { copyBtn.textContent = 'Copy'; copyBtn.classList.remove('copied'); }, 1200);
  });
});
document.addEventListener('paste', async e => {
  const items = e.clipboardData?.items;
  if (!items) return;
  const imgs = Array.from(items).filter(i => i.type.startsWith('image/'));
  if (imgs.length === 0) return;
  e.preventDefault();
  const files = imgs.map(i => i.getAsFile()).filter(Boolean);
  processFiles(files.map((f, i) => new File([f], `pasted-${Date.now()}-${i}.png`, { type: f.type })));
});
</script>
