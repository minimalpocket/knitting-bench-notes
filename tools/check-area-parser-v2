G([0x00,0x00,0x10,0x10,0x10,0x10,0x7c,0x10,0x10,0x10,0x10,0x10,0x10,0x0c,0x00,0x00], 't');

// Table background luminance thresholds (66 ~ #424242, ±4)
const BG_LO = 62, BG_HI = 70;

// Luminance threshold for binarization.
// Dialog text pixels are nominally 255 against background of 66.
// After JPEG compression: observed spread (220..255) vs (50..85)
// 200 sits comfortably in the gap.
const BRIGHT_THRESHOLD = 200;

/** RGBA ImageData → {width, height, data: Uint8Array} luminance raster */
function imageToLuminance(imageData) {
  const { width, height, data } = imageData;
  const lum = new Uint8Array(width * height);
  for (let i = 0; i < lum.length; i++) {
    const j = i * 4;
    lum[i] = Math.round(0.299 * data[j] + 0.587 * data[j+1] + 0.114 * data[j+2]);
  }
  return { width, height, data: lum };
}

/** Auto-detect the 0x42 table region and crop to content rows.
 *  Returns {width, height, data: Uint8Array} or null. */
function detectAndCrop(lum) {
  const { width: w, height: h, data } = lum;
  const isBg = v => v >= BG_LO && v <= BG_HI;
  const getRow = y => data.subarray(y * w, (y + 1) * w);

  // Find rows where >40% of pixels are bg
  const tableRows = [];
  for (let y = 0; y < h; y++) {
    const row = getRow(y);
    let n = 0;
    for (let x = 0; x < w; x++) if (isBg(row[x])) n++;
    if (n > w * 0.4) tableRows.push(y);
  }
  if (tableRows.length === 0) return null;

  const y0 = tableRows[0], y1 = tableRows[tableRows.length - 1];

  // Find column extent
  const colCounts = new Uint32Array(w);
  for (const y of tableRows) {
    const row = getRow(y);
    for (let x = 0; x < w; x++) if (isBg(row[x])) colCounts[x]++;
  }
  let x0 = w, x1 = 0;
  const colThresh = tableRows.length * 0.2;
  for (let x = 0; x < w; x++) {
    if (colCounts[x] > colThresh) {
      if (x < x0) x0 = x;
      if (x > x1) x1 = x;
    }
  }
  x1++;

  // Filter to rows containing bg, refine horizontal bounds from last row
  const contentRows = [];
  for (let y = y0; y <= y1; y++) {
    const row = getRow(y);
    let hasBg = false;
    for (let x = x0; x < x1; x++) { if (isBg(row[x])) { hasBg = true; break; } }
    if (hasBg) contentRows.push(y);
  }
  if (contentRows.length === 0) return null;

  const lastRow = getRow(contentRows[contentRows.length - 1]);
  let cx0 = x1, cx1 = x0;
  for (let x = x0; x < x1; x++) {
    if (isBg(lastRow[x])) {
      if (x < cx0) cx0 = x;
      if (x > cx1) cx1 = x;
    }
  }
  cx1++;

  const cw = cx1 - cx0, ch = contentRows.length;
  const cropped = new Uint8Array(cw * ch);
  for (let i = 0; i < ch; i++) {
    const srcRow = getRow(contentRows[i]);
    cropped.set(srcRow.subarray(cx0, cx1), i * cw);
  }
  return { width: cw, height: ch, data: cropped };
}

/** Detect text column offset by finding the color swatch border.
 *  Swatches have a grey border (~145 lum) at rows 2–13 of each 16px entry.
 *  Text starts 6 columns after the swatch's right edge. */
function detectTextOffset(cropped) {
  const { width: cw, height: ch, data } = cropped;
  const nEntries = Math.min(5, Math.floor(ch / 16));
  const scanW = Math.min(20, cw);
  const scores = new Float64Array(scanW);
  for (let col = 0; col < scanW; col++) {
    for (let e = 0; e < nEntries; e++) {
      for (let r = 2; r < 14; r++) {
        const v = data[(e * 16 + r) * cw + col];
        if (v >= 120 && v <= 160) scores[col]++;
      }
    }
  }
  const threshold = nEntries * 4;
  let rightEdge = 13; // fallback for pre-cropped images
  for (let col = scanW - 1; col >= 0; col--) {
    if (scores[col] >= threshold) { rightEdge = col; break; }
  }
  return rightEdge + 6;
}

/** Pack 8 pixels into a byte (MSB first), thresholding at BRIGHT_THRESHOLD. */
function packByte(data, offset) {
  let v = 0;
  for (let b = 0; b < 8; b++) {
    v = (v << 1) | (data[offset + b] > BRIGHT_THRESHOLD ? 1 : 0);
  }
  return v;
}

/** Parse a cropped luminance raster into [{iro, count}, ...] */
function parseCropped(cropped) {
  const { width: cw, height: ch, data } = cropped;
  const GH = 16, GW = 8;
  const offset = detectTextOffset(cropped);
  const nEntries = Math.floor(ch / GH);
  const nGlyphs = Math.floor((cw - offset) / GW);
  const results = [];

  for (let e = 0; e < nEntries; e++) {
    let text = '';
    for (let g = 0; g < nGlyphs; g++) {
      const col = offset + g * GW;
      if (col + GW > cw) break;
      const packed = [];
      for (let r = 0; r < GH; r++) {
        packed.push(packByte(data, (e * GH + r) * cw + col));
      }
      text += GLYPH_TABLE.get(packed.join(',')) ?? '?';
    }
    const m = text.match(/\s*(\d+).*?\[\s*(\d+)\s+Dot\]/);
    if (m) {
      results.push({ iro: parseInt(m[1]), count: parseInt(m[2]) });
    }
  }
  return results;
}

/** Extract opline tag from filename: "foo-R3.PNG" → "R3" */
function extractOpline(filename) {
  const m = filename.toUpperCase().match(/([RL]\d+)\./);
  return m ? m[1] : null;
}

/** Top-level: ImageData + filename → parsed result object */
function parseCheckArea(imageData, filename) {
  const lum = imageToLuminance(imageData);
  const cropped = detectAndCrop(lum);
  if (!cropped) {
    return { filename, opline: extractOpline(filename), error: 'No table detected (0x42 background not found)', entries: [] };
  }
  const entries = parseCropped(cropped);
  if (entries.length === 0) {
    return { filename, opline: extractOpline(filename), error: 'Table found but glyph recognition failed (check DPI scaling)', entries: [] };
  }
  return { filename, opline: extractOpline(filename), entries, error: null };
}

// END_PARSER

